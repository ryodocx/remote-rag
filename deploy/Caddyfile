{
    servers {
        metrics
    }
    tracing {
        span rrag_proxy
    }
}

:2019 {
    metrics
}

:8080 {
    # 全リクエストに対して認証ヘルパーへの検証を実行する
    forward_auth auth-helper:8000 {
        uri /auth
    }

    # REST API (Custom GPTs / Actions 向け) — /api/* を rest-api コンテナへ転送
    handle /api/* {
        reverse_proxy rest-api:8010
    }

    # MCP Server (Bridge CLI / デスクトップ AI エージェント向け)
    # Bridge CLIからの初期接続 (ルートへのリクエスト) を /sse に書き換える
    @root {
        path /
    }
    rewrite @root /sse

    reverse_proxy mcp-server:8000 {
        header_up Host {host}

        # SSE (Server-Sent Events) 対応のため、バッファリングを完全に無効化する
        flush_interval -1
    }
}
