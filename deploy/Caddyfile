{
    servers {
        metrics
    }
    tracing {
        span rrag_proxy
    }
}

:2019 {
    metrics
}

:8080 {
    # 全リクエストに対して認証ヘルパーへの検証を実行する
    forward_auth auth-helper:8000 {
        uri /auth
    }

    # REST API (Custom GPTs / Actions 向け)
    # /v1/api/* → rrag-server:8010 へ転送（プレフィックスを除去して渡す）
    handle /v1/api/* {
        uri strip_prefix /v1/api
        reverse_proxy rrag-server:8010
    }

    # MCP Server (Bridge CLI / デスクトップ AI エージェント向け)
    # /v1/mcp/* → rrag-server:8000 へ転送（プレフィックスを除去して渡す）
    handle /v1/mcp/* {
        uri strip_prefix /v1/mcp
        reverse_proxy rrag-server:8000 {
            header_up Host {host}

            # SSE (Server-Sent Events) 対応のため、バッファリングを完全に無効化する
            flush_interval -1
        }
    }

    # FastMCP が自動返却する POST エンドポイント (/messages) に対するルーティング
    handle /messages {
        reverse_proxy rrag-server:8000
    }
}
